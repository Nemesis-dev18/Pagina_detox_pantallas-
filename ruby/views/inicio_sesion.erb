<header class="cabecera">
    <div class="hero">
        <div class="hero-left" id="logo"><img src="/img/cirno-cirno-fumo.gif" alt="Logo DETOX_WEB"></div>
        <div class="hero-center"><h1>DETOX_WEB</h1></div>
    </div>
</header>
<section class="texto_sesion">
    <div class="registro">
        <h2 class="titulo">Bienvenido de nuevo</h2>
        <form class="sesion" action="/inicio_sesion" method="post">
            <div class="user"><input type="email" placeholder="Correo electrónico" name="username" required></div>
            <div class="contraseña"><input type="password" placeholder="Contraseña" name="password" required></div>
            <div class="boton_sesion"><button type="submit">Iniciar sesión</button></div>
        </form>
        <div class="enlaces-sesion">
            <a href="/recuperar_contraseña">¿Olvidaste tu contraseña?</a>
            <p>¿No tienes cuenta? <a class="linkeo" href="/registro">Crear cuenta</a></p>
        </div>
    </div>
    <div class="imagen2_sesion"><img src="/img/img1.jpeg" alt="Personas trabajando juntas"></div>
</section>
